---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { sanityClient, urlFor } from '../lib/sanity';
import { sanityImg, localImg, localSrcset } from '../lib/sanityImage';
import { featuredProductsQuery, allCategoriesQuery, testimonialsQuery, homepageFaqsQuery } from '../lib/queries';
import { PRICES, CATEGORIES, STYLES } from '../data/products';

let featuredProducts: any[] = [];
let categories: any[] = [];
let testimonials: any[] = [];
let faqs: any[] = [];

// Before/after examples for the "Your Photo" band — the same images the
// builder shows on its style pills, so the homepage can never advertise a
// style that has been turned off.
let photoStyles: { label: string; blurb?: string; before?: string; after?: string }[] = [];

// No try/catch: if Sanity is down the build fails and the live site stays as
// it was, instead of publishing a homepage with no products, FAQs or reviews.
[featuredProducts, categories, testimonials, faqs] = await Promise.all([
  sanityClient.fetch(featuredProductsQuery),
  sanityClient.fetch(allCategoriesQuery),
  sanityClient.fetch(testimonialsQuery),
  sanityClient.fetch(homepageFaqsQuery),
]);
if (!categories?.length || !faqs?.length) {
  throw new Error('[index] Sanity returned no categories or FAQs');
}
photoStyles = await sanityClient.fetch(`
  *[_type == "personalisationStyle" && active == true && defined(exampleAfter)] | order(sortOrder asc)[0...4] {
    label, blurb,
    "before": exampleBefore.asset->url,
    "after": exampleAfter.asset->url
  }
`) || [];
---

<BaseLayout
  title="Pixel8 Multimedia — Premium Pop Culture Wall Art"
  description="Premium pop culture wall art and bespoke photo transformations: canvas and poster prints and custom commissions. Made in the UK, delivered to UK addresses."
>
  <!-- The hero artwork only shows from lg up, so only preload it there. -->
  <link slot="head" rel="preload" as="image" fetchpriority="high" media="(min-width: 1024px)"
        href={localImg('/mockups/hero-artwork.png', 800)}
        imagesrcset={localSrcset('/mockups/hero-artwork.png', 800, 1024)}
        imagesizes="(min-width: 1280px) 800px, 62vw" />

  <!-- ===== HERO ===== -->
  <section class="relative min-h-[90vh] flex items-center bg-bg-primary overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-bg-primary via-bg-secondary to-bg-primary"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 grid lg:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <span class="font-mono text-xs text-pop-orange uppercase tracking-widest mb-4 block">UK Made · UK Delivery</span>
        <h1 class="font-montserrat text-5xl md:text-6xl lg:text-7xl font-bold text-off-white leading-tight mb-6">
          Where Pop Culture Meets
          <span class="logo-gradient block">Pixel-Perfect Art</span>
        </h1>
        <p class="font-dm text-lg text-mid-grey leading-relaxed mb-8 max-w-xl">
          Bold pop culture wall art — or upload your own photo and watch it redrawn in our house styles in under a minute. Printed to order in the UK.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/store/" class="btn-primary">Shop Wall Art</a>
          <a href="/store/your-photo/" class="btn-secondary">Use Your Own Photo</a>
        </div>
        <div class="flex items-center gap-6 mt-8 text-sm text-mid-grey font-dm">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-pop-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            1000+ Artworks
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-pixel-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            10 Options Per Artwork
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-hot-magenta" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Made In-House
          </span>
        </div>
      </div>
      <div class="hidden lg:block reveal stagger-2">
        <div class="w-full aspect-[3/4] rounded-lg overflow-hidden border border-edge-line">
          <img src={localImg('/mockups/hero-artwork.png', 800)} srcset={localSrcset('/mockups/hero-artwork.png', 800, 1024)} sizes="(min-width: 1280px) 800px, (min-width: 1024px) 62vw, 1px" width="1024" height="1024" fetchpriority="high" alt="Pikachu Noir style wall art by Pixel8 Multimedia" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== OUR WAY / YOUR WAY ===== -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-8">
      <a href="/store/" class="group bg-bg-secondary border border-edge-line rounded-lg overflow-hidden hover:border-pop-orange hover:shadow-glow-orange transition-all duration-300 reveal">
        <div class="aspect-[16/9] bg-bg-tertiary flex items-center justify-center overflow-hidden">
          <img src={localImg('/mockups/our-way-hero.png', 600)} srcset={localSrcset('/mockups/our-way-hero.png', 600, 2752)} sizes="(min-width: 768px) 600px, 100vw" width="2752" height="1536" alt="Pop culture wall art collection preview" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="p-6">
          <h2 class="font-montserrat text-2xl font-bold text-off-white mb-2">Our Way</h2>
          <p class="font-dm text-mid-grey text-sm leading-relaxed mb-4">Explore our pop culture wall art across 6 categories and 10 unique options. Canvas prints and posters ready to ship.</p>
          <span class="font-montserrat text-sm font-bold text-pop-orange uppercase tracking-wider">Browse the Shop →</span>
        </div>
      </a>
      <a href="/services/" class="group bg-bg-secondary border border-edge-line rounded-lg overflow-hidden hover:border-pixel-cyan hover:shadow-glow-cyan transition-all duration-300 reveal stagger-1">
        <div class="aspect-[16/9] bg-bg-tertiary flex items-center justify-center overflow-hidden">
          <img src={localImg('/mockups/your-way-hero.jpeg', 600)} srcset={localSrcset('/mockups/your-way-hero.jpeg', 600, 2752)} sizes="(min-width: 768px) 600px, 100vw" width="2752" height="1536" alt="Custom personalised services preview" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="p-6">
          <h2 class="font-montserrat text-2xl font-bold text-off-white mb-2">Your Way</h2>
          <p class="font-dm text-mid-grey text-sm leading-relaxed mb-4">Commission something uniquely yours. Photo restoration, Stills to Reels animation, and bespoke artwork.</p>
          <span class="font-montserrat text-sm font-bold text-pixel-cyan uppercase tracking-wider">Start Your Project →</span>
        </div>
      </a>
    </div>
  </section>


  <!-- ===== YOUR PHOTO ===== -->
  <section class="py-20 bg-bg-primary border-y border-edge-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <span class="font-mono text-xs text-pixel-cyan uppercase tracking-widest">New &middot; no waiting, no brief</span>
        <h2 class="section-heading mt-2">One photo. Eight styles.</h2>
        <p class="font-dm text-mid-grey max-w-2xl mx-auto mt-4 leading-relaxed">
          Upload a photo, pick a style, and see your design in about a minute — then choose a poster or canvas.
          No commission form, no back and forth.
        </p>
      </div>

      {photoStyles.length > 0 && (
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 sm:gap-4 mb-10 reveal stagger-1">
          {photoStyles[0].before && (
            <figure class="relative">
              <img src={sanityImg(photoStyles[0].before, 400, { h: 400 })} width="400" height="400"
                   alt="An ordinary photo before styling"
                   class="w-full aspect-square object-cover rounded-lg border border-edge-line" loading="lazy" />
              <figcaption class="absolute top-2 left-2 font-mono text-[0.6rem] uppercase tracking-wider bg-black/75 text-off-white px-2 py-1 rounded">
                Your photo
              </figcaption>
            </figure>
          )}
          {photoStyles.map((s) => (
            <figure class="relative">
              <img src={sanityImg(s.after, 400, { h: 400 })} width="400" height="400"
                   alt={`The same photo in the ${s.label} style`}
                   class="w-full aspect-square object-cover rounded-lg border border-edge-line" loading="lazy" />
              <figcaption class="absolute bottom-2 left-2 font-montserrat text-[0.65rem] font-semibold bg-black/75 text-off-white px-2 py-1 rounded">
                {s.label}
              </figcaption>
            </figure>
          ))}
        </div>
      )}

      <div class="grid sm:grid-cols-3 gap-6 mb-10 max-w-4xl mx-auto reveal stagger-2">
        <div class="text-center">
          <div class="font-mono text-pop-orange text-sm mb-1">01</div>
          <p class="font-dm text-sm text-mid-grey">Upload a photo and crop it square.</p>
        </div>
        <div class="text-center">
          <div class="font-mono text-pixel-cyan text-sm mb-1">02</div>
          <p class="font-dm text-sm text-mid-grey">Try up to four styles and compare them side by side.</p>
        </div>
        <div class="text-center">
          <div class="font-mono text-hot-magenta text-sm mb-1">03</div>
          <p class="font-dm text-sm text-mid-grey">Approve your proof — then we print and post it.</p>
        </div>
      </div>

      <div class="text-center reveal stagger-3">
        <a href="/store/your-photo/" class="btn-primary">Try It With Your Photo</a>
        <p class="font-dm text-xs text-deep-grey mt-3">From £14.99 including the personalisation fee</p>
      </div>
    </div>
  </section>

  <!-- ===== CATEGORIES ===== -->
  <section class="py-20 bg-bg-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-12 reveal">
        <div>
          <span class="font-mono text-xs text-pixel-cyan uppercase tracking-widest">6 Categories · 10 Options</span>
          <h2 class="section-heading mt-2">Browse by Category</h2>
        </div>
        <a href="/store/" class="font-montserrat text-sm font-bold text-pop-orange uppercase tracking-wider hover:underline hidden md:block">View All →</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {(categories.length > 0 ? categories : CATEGORIES).map((cat: any, i: number) => (
          <a href={cat.slug === 'personalised' ? '/store/your-photo/' : `/store/?category=${cat.slug}`}
             class={`bg-bg-primary border border-edge-line rounded-lg overflow-hidden hover:border-pop-orange transition-all duration-300 reveal stagger-${Math.min(i + 1, 4)}`}>
            <div class="aspect-[4/3] bg-bg-tertiary flex items-center justify-center">
              {cat.coverImage?.asset ? (
                <img src={urlFor(cat.coverImage).width(400).height(300).auto('format').quality(75).url()} width="400" height="300" alt={cat.name} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <span class="font-montserrat text-[0.6rem] text-deep-grey uppercase tracking-widest text-center px-2">{cat.name}</span>
              )}
            </div>
            <div class="p-3">
              <h3 class="font-montserrat text-sm font-bold text-off-white">{cat.name}</h3>
              <p class="font-dm text-xs text-deep-grey mt-0.5">{cat.tagline || cat.description}</p>
              {cat.productCount != null && <p class="font-mono text-xs text-pop-orange mt-1">{cat.productCount} designs</p>}
            </div>
          </a>
        ))}
      </div>
      <a href="/store/" class="font-montserrat text-sm font-bold text-pop-orange uppercase tracking-wider hover:underline mt-6 block md:hidden">View All →</a>
    </div>
  </section>

  <!-- ===== MADE TO ORDER (Orange block) ===== -->
  <section class="colour-block-orange py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <h2 class="font-montserrat text-4xl md:text-5xl font-bold mb-6">Made to Order</h2>
          <p class="font-dm text-lg leading-relaxed mb-6">
            Every piece is crafted to stand out — designed for those who want their walls to tell a story. Each artwork is produced individually for you.
          </p>
          <div class="space-y-3 font-dm">
            <p><strong>Three sizes:</strong> Small (12×12") · Medium (16×16") · Large (20×20")</p>
            <p><strong>Three finishes:</strong> Poster Print · Canvas (Standard Frame) · Canvas (Gallery Frame)</p>
          </div>
          <a href="/store/" class="inline-block mt-8 bg-black text-pop-orange font-montserrat font-bold text-sm uppercase tracking-wider px-8 py-3 hover:bg-bg-secondary transition-colors">Shop Now</a>
        </div>
        <div class="grid grid-cols-2 gap-4 reveal stagger-2">
          <div class="aspect-square rounded-lg overflow-hidden"><img src={localImg('/mockups/mockup-1.jpg', 290)} srcset={localSrcset('/mockups/mockup-1.jpg', 290, 1024)} sizes="(min-width: 1024px) 290px, 50vw" width="1024" height="1024" alt="Pop culture wall art in a gaming room" class="w-full h-full object-cover" loading="lazy" /></div>
          <div class="aspect-square rounded-lg overflow-hidden"><img src={localImg('/mockups/mockup-2.jpg', 290)} srcset={localSrcset('/mockups/mockup-2.jpg', 290, 1024)} sizes="(min-width: 1024px) 290px, 50vw" width="1024" height="1024" alt="Bob Marley wall art in a bedroom" class="w-full h-full object-cover" loading="lazy" /></div>
          <div class="aspect-square rounded-lg overflow-hidden"><img src={localImg('/mockups/mockup-3.jpg', 290)} srcset={localSrcset('/mockups/mockup-3.jpg', 290, 1024)} sizes="(min-width: 1024px) 290px, 50vw" width="1024" height="1024" alt="Pink Panther wall art in an office" class="w-full h-full object-cover" loading="lazy" /></div>
          <div class="aspect-square rounded-lg overflow-hidden"><img src={localImg('/mockups/mockup-4.jpg', 290)} srcset={localSrcset('/mockups/mockup-4.jpg', 290, 1024)} sizes="(min-width: 1024px) 290px, 50vw" width="1024" height="1024" alt="Hulk wall art in a living room" class="w-full h-full object-cover" loading="lazy" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING (Cyan block) ===== -->
  <section class="colour-block-cyan py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <div class="aspect-[4/3] rounded-lg overflow-hidden">
            <img src={localImg('/mockups/studio.png', 600)} srcset={localSrcset('/mockups/studio.png', 600, 2752)} sizes="(min-width: 1024px) 600px, 100vw" width="2752" height="1536" alt="Pixel8 Multimedia print studio" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>
        <div class="reveal stagger-1">
          <h2 class="font-montserrat text-4xl md:text-5xl font-bold mb-8">Pricing</h2>
          <div class="space-y-6">
            <div>
              <h3 class="font-montserrat font-bold text-lg mb-2">Poster Prints</h3>
              <p class="font-mono text-sm">Small — £{PRICES.poster.small.toFixed(2)} · Medium — £{PRICES.poster.medium.toFixed(2)} · Large — £{PRICES.poster.large.toFixed(2)}</p>
            </div>
            <div>
              <h3 class="font-montserrat font-bold text-lg mb-2">Canvas (Standard Frame)</h3>
              <p class="font-mono text-sm">Small — £{PRICES.canvasStandard.small.toFixed(2)} · Medium — £{PRICES.canvasStandard.medium.toFixed(2)} · Large — £{PRICES.canvasStandard.large.toFixed(2)}</p>
            </div>
            <div>
              <h3 class="font-montserrat font-bold text-lg mb-2">Canvas (Gallery Frame)</h3>
              <p class="font-mono text-sm">Small — £{PRICES.canvasGallery.small.toFixed(2)} · Medium — £{PRICES.canvasGallery.medium.toFixed(2)} · Large — £{PRICES.canvasGallery.large.toFixed(2)}</p>
            </div>
          </div>
          <p class="font-dm text-sm mt-6 opacity-70">Free UK P&P on orders of £50 and over. Prints are delivered to UK addresses only.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FEATURED PRODUCTS ===== -->
  {featuredProducts.length > 0 && (
    <section class="py-20 bg-bg-primary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-12 reveal">
          <div>
            <span class="font-mono text-xs text-hot-magenta uppercase tracking-widest">Fresh From the Studio</span>
            <h2 class="section-heading mt-2">Latest Drops</h2>
          </div>
          <a href="/store/" class="font-montserrat text-sm font-bold text-pop-orange uppercase tracking-wider hover:underline hidden md:block">View All →</a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {featuredProducts.map((product: any) => (
            <div class="reveal">
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== SERVICES ===== -->
  <section class="py-20 bg-bg-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <span class="font-mono text-xs text-pixel-cyan uppercase tracking-widest">Your Way</span>
        <h2 class="section-heading mt-2">Custom Services</h2>
        <p class="font-dm text-mid-grey text-lg max-w-2xl mx-auto mt-4">Your vision, our craft. Every piece is uniquely yours — choose digital delivery or premium print.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/services/cartoonify-me/" class="bg-bg-primary border border-edge-line rounded-lg overflow-hidden hover:border-hot-magenta hover:shadow-glow-magenta transition-all duration-300 group reveal">
          <div class="aspect-[16/9] overflow-hidden"><img src={localImg('/services/cartoonify-me.png', 400)} srcset={localSrcset('/services/cartoonify-me.png', 400, 2752)} sizes="(min-width: 768px) 400px, 100vw" width="2752" height="1536" alt="Cartoonify Me service example" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" /></div>
          <div class="p-5">
            <h3 class="font-montserrat text-lg font-bold text-off-white mb-1 group-hover:text-hot-magenta transition-colors">Cartoonify Me!</h3>
            <p class="font-dm text-sm text-mid-grey leading-relaxed mb-3">Turn your photo into a cartoon masterpiece — Simpsons, Anime, Pixar, and more.</p>
            <span class="font-mono text-xs text-hot-magenta uppercase tracking-wider">Digital + Print →</span>
          </div>
        </a>
        <a href="/services/stills-to-reels/" class="bg-bg-primary border border-edge-line rounded-lg overflow-hidden hover:border-pixel-cyan hover:shadow-glow-cyan transition-all duration-300 group reveal">
          <div class="aspect-[16/9] overflow-hidden"><img src={localImg('/services/stills-to-reels.png', 400)} srcset={localSrcset('/services/stills-to-reels.png', 400, 2752)} sizes="(min-width: 768px) 400px, 100vw" width="2752" height="1536" alt="Stills to Reels service example" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" /></div>
          <div class="p-5">
            <h3 class="font-montserrat text-lg font-bold text-off-white mb-1 group-hover:text-pixel-cyan transition-colors">Stills to Reels</h3>
            <p class="font-dm text-sm text-mid-grey leading-relaxed mb-3">Transform static images into dynamic animations you can share, showcase, or keep forever.</p>
            <span class="font-mono text-xs text-pixel-cyan uppercase tracking-wider">Digital + Print →</span>
          </div>
        </a>
        <a href="/services/the-missing-moment/" class="bg-bg-primary border border-edge-line rounded-lg overflow-hidden hover:border-pop-orange hover:shadow-glow-orange transition-all duration-300 group reveal">
          <div class="aspect-[16/9] overflow-hidden"><img src={localImg('/services/the-missing-moment.jpeg', 400)} srcset={localSrcset('/services/the-missing-moment.jpeg', 400, 2752)} sizes="(min-width: 768px) 400px, 100vw" width="2752" height="1536" alt="The Missing Moment service example" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" /></div>
          <div class="p-5">
            <h3 class="font-montserrat text-lg font-bold text-off-white mb-1 group-hover:text-pop-orange transition-colors">The Missing Moment</h3>
            <p class="font-dm text-sm text-mid-grey leading-relaxed mb-3">Add someone special into an existing photo — a loved one who has passed, or a friend who missed your wedding.</p>
            <span class="font-mono text-xs text-pop-orange uppercase tracking-wider">Digital + Print →</span>
          </div>
        </a>
        <a href="/services/past-perfect/" class="bg-bg-primary border border-edge-line rounded-lg overflow-hidden hover:border-pop-orange hover:shadow-glow-orange transition-all duration-300 group reveal">
          <div class="aspect-[16/9] overflow-hidden"><img src={localImg('/services/past-perfect.png', 400)} srcset={localSrcset('/services/past-perfect.png', 400, 2752)} sizes="(min-width: 768px) 400px, 100vw" width="2752" height="1536" alt="Past Perfect service example" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" /></div>
          <div class="p-5">
            <h3 class="font-montserrat text-lg font-bold text-off-white mb-1 group-hover:text-pop-orange transition-colors">Past Perfect</h3>
            <p class="font-dm text-sm text-mid-grey leading-relaxed mb-3">Restore treasured memories with professional photo repair and colourisation.</p>
            <span class="font-mono text-xs text-pop-orange uppercase tracking-wider">Digital + Print →</span>
          </div>
        </a>
        <a href="/services/your-song-your-story/" class="bg-bg-primary border border-edge-line rounded-lg overflow-hidden hover:border-pixel-cyan hover:shadow-glow-cyan transition-all duration-300 group reveal">
          <div class="aspect-[16/9] overflow-hidden"><img src={localImg('/services/your-song-your-story.png', 400)} srcset={localSrcset('/services/your-song-your-story.png', 400, 2752)} sizes="(min-width: 768px) 400px, 100vw" width="2752" height="1536" alt="Your Song Your Story service example" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" /></div>
          <div class="p-5">
            <h3 class="font-montserrat text-lg font-bold text-off-white mb-1 group-hover:text-pixel-cyan transition-colors">Your Song Your Story</h3>
            <p class="font-dm text-sm text-mid-grey leading-relaxed mb-3">Turn memories, milestones, or inside jokes into an original song composed just for you.</p>
            <span class="font-mono text-xs text-pixel-cyan uppercase tracking-wider">Digital Only →</span>
          </div>
        </a>
        <a href="/services/story-of-your-life/" class="bg-bg-primary border border-edge-line rounded-lg overflow-hidden hover:border-pixel-cyan hover:shadow-glow-cyan transition-all duration-300 group reveal">
          <div class="aspect-[16/9] overflow-hidden"><img src={localImg('/services/story-of-your-life.jpeg', 400)} srcset={localSrcset('/services/story-of-your-life.jpeg', 400, 2752)} sizes="(min-width: 768px) 400px, 100vw" width="2752" height="1536" alt="Story Of Your Life service example" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" /></div>
