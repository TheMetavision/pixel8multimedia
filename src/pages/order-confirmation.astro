---
export const prerender = false;

import Stripe from 'stripe';
import BaseLayout from '../layouts/BaseLayout.astro';

// The delivery charge this order actually paid, from its Stripe session
// (success_url carries ?session_id=): "£4.95" or "Free". If the session
// can't be read, the line is left out rather than guessed.
let delivery: string | null = null;
const sessionId = Astro.url.searchParams.get('session_id') || '';
const stripeKey = process.env.STRIPE_SECRET_KEY;
if (stripeKey && /^cs_(test|live)_[A-Za-z0-9]{10,200}$/.test(sessionId)) {
  try {
    const session = await new Stripe(stripeKey, { apiVersion: '2024-12-18.acacia' }).checkout.sessions.retrieve(sessionId);
    const pence = session.shipping_cost?.amount_total ?? session.total_details?.amount_shipping;
    if (typeof pence === 'number') delivery = pence === 0 ? 'Free' : `£${(pence / 100).toFixed(2)}`;
  } catch (err: any) {
    console.warn('order-confirmation: could not read the Stripe session:', err?.message);
  }
}
---

<BaseLayout
  title="Order Confirmed"
  description="Your Pixel8 Multimedia order has been confirmed. Thank you for your purchase!"
  noindex={true}
>
  <section class="relative bg-bg-primary py-20 min-h-[60vh]">
    <div class="absolute inset-0  opacity-40"></div>
    <div class="absolute top-0 left-0 right-0 h-1 bg-pop-orange"></div>

    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 relative text-center">
      <!-- Success State -->
      <div id="confirmation-content">
        <div class=" inline-block mb-8 text-lg">KA-POW!</div>

        <h1 class="font-montserrat font-bold text-5xl md:text-7xl text-off-white tracking-wide mb-6"
            style="text-shadow: 4px 4px 0 rgba(0,0,0,0.5);">
          ORDER <span class="text-pop-orange">CONFIRMED!</span>
        </h1>

        <p class="font-dm text-gray-300 text-lg leading-relaxed mb-8 max-w-lg mx-auto">
          Thank you for your order! We've sent a confirmation to your email with all the details.
          Your artwork is being prepared with care.
        </p>

        <div class="bg-bg-secondary border-4 border-edge-line p-8 text-left mb-8" style="box-shadow: 5px 5px 0 #000;">
          <h2 class="font-montserrat font-semibold text-off-white text-sm uppercase tracking-wide mb-4 pb-3 border-b-2 border-gray-700">
            What Happens Next
          </h2>
          <div class="space-y-4">
            <div class="flex gap-4 items-start">
              <div class="w-8 h-8 bg-pop-orange border-2 border-edge-line flex items-center justify-center flex-shrink-0 font-montserrat font-bold text-black">1</div>
              <div>
                <p class="font-montserrat font-semibold text-off-white text-sm">Order Received</p>
                <p class="font-dm text-gray-400 text-xs">We've got your order and payment is confirmed.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start">
              <div class="w-8 h-8 bg-bg-secondary border-2 border-gray-600 flex items-center justify-center flex-shrink-0 font-montserrat font-bold text-gray-500">2</div>
              <div>
                <p class="font-montserrat font-semibold text-gray-400 text-sm">In Production</p>
                <p class="font-dm text-gray-500 text-xs">Your artwork is being printed and prepared.</p>
              </div>
            </div>
            <div class="flex gap-4 items-start">
              <div class="w-8 h-8 bg-bg-secondary border-2 border-gray-600 flex items-center justify-center flex-shrink-0 font-montserrat font-bold text-gray-500">3</div>
              <div>
                <p class="font-montserrat font-semibold text-gray-400 text-sm">Dispatched</p>
                <p class="font-dm text-gray-500 text-xs">You'll receive an email with tracking details.</p>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t-2 border-gray-700">
            <p class="font-dm text-gray-400 text-xs">
              <strong class="text-off-white">Estimated delivery:</strong> 3-6 working days from dispatch.
              {delivery && <>UK P&amp;P: {delivery}.</>}
            </p>
          </div>
        </div>

        <div class="flex flex-wrap justify-center gap-4">
          <a href="/store/" class="btn-primary">CONTINUE SHOPPING</a>
          <a href="/contact/" class="btn-secondary">GOT A QUESTION?</a>
        </div>
      </div>

      <!-- Loading State -->
      <div id="loading-state" class="hidden">
        <div class="animate-pulse">
          <div class="w-16 h-16 bg-pop-orange border-4 border-edge-line mx-auto mb-6 flex items-center justify-center" style="box-shadow: 3px 3px 0 #000;">
            <span class="font-montserrat font-bold text-2xl text-black">...</span>
          </div>
          <p class="font-montserrat font-semibold text-gray-400">Processing your order...</p>
        </div>
      </div>

      <!-- Error State -->
      <div id="error-state" class="hidden">
        <h2 class="font-montserrat font-bold text-4xl text-off-white tracking-wide mb-4">SOMETHING WENT WRONG</h2>
        <p class="font-dm text-gray-300 mb-6">We couldn't verify your order details, but don't worry — if payment was taken, your order is safe. Check your email for confirmation.</p>
        <a href="/contact/" class="btn-primary">CONTACT US</a>
      </div>
    </div>
  </section>

  <script>
    // Clear the cart after successful checkout
    import { clearCart } from '../stores/cart';
    
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get('session_id');
    
    if (sessionId) {
      // Clear the cart
      clearCart();
    }
  </script>
</BaseLayout>
