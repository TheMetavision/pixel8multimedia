# ── Pixel8 Multimedia — Environment Variables ──
# Copy to .env and fill in values. Add all to Netlify dashboard > Site > Environment.

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_COMMISSION_WEBHOOK_SECRET=whsec_...

# Sanity (write token — for functions that create/patch commission docs)
SANITY_TOKEN=sk...

# Sanity Webhook (optional but recommended — GROQ webhook secret for commission-deliver)
SANITY_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=re_...

# Download link signing secret (generate with: openssl rand -hex 32)
DOWNLOAD_LINK_SECRET=

# Site URL (auto-set by Netlify, override for local dev)
URL=https://pixel8multimedia.co.uk

# ── Groupon voucher redemption ──────────────────────────────────────────────
# Accept well-formed codes that aren't in the imported list, recording them as
# unverified for later reconciliation. LEAVE THIS OFF unless Groupon volume is
# outrunning the import cadence — with it on, anyone who works out the code
# format gets free work. If you do turn it on, check the unverified queue daily:
#   node --env-file=.env scripts/groupon-vouchers.mjs status
GROUPON_ALLOW_UNVERIFIED=false
# Only used when the above is true — the service and value an unverified code
# is assumed to entitle. Set to your lowest-value campaign so a bad guess costs
# the least.
GROUPON_UNVERIFIED_SERVICE_SLUG=
GROUPON_UNVERIFIED_VALUE_PENCE=
