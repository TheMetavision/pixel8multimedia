# ── Pixel8 Multimedia — Environment Variables ──
# Copy to .env and fill in values. Add all to Netlify dashboard > Site > Environment.

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_COMMISSION_WEBHOOK_SECRET=whsec_...

# Sanity (write token — for functions that create/patch commission docs)
SANITY_TOKEN=sk...
# Optional read-only (Viewer) token for the site build + SSR pages; falls back to SANITY_TOKEN
SANITY_READ_TOKEN=

# Sanity Webhook (optional but recommended — GROQ webhook secret for commission-deliver)
SANITY_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=re_...

# Download link signing secret (generate with: openssl rand -hex 32)
DOWNLOAD_LINK_SECRET=

# Site URL (auto-set by Netlify, override for local dev)
URL=https://pixel8multimedia.co.uk

# ── Groupon voucher redemption ──────────────────────────────────────────────
# STRICT MODE is the default: a code not in the imported list is refused at
# input, so no order can ever exist against an unverified code. The cost is
# that customers who bought AFTER the last import are asked to try again
# tomorrow — which makes the import cadence the thing that matters. Import
# daily while campaigns are live.
#
# Set to true to switch to accept-then-verify: unknown codes are accepted on
# the customer's word and the order is HELD (cannot be worked or delivered)
# until confirmed via `groupon-vouchers.mjs verify/confirm`.
GROUPON_ACCEPT_UNKNOWN=false
# Only used in accept-then-verify mode: cap on unconfirmed vouchers per IP.
GROUPON_MAX_UNCHECKED_PER_IP=3

# ── Read by the code but previously missing from this file ──────────────────
# Sanity project id for webhook.mjs (falls back to bqb4w421)
SANITY_PROJECT_ID=
# Sanity dataset (defaults to production)
SANITY_DATASET=
# Editor token used by webhook.mjs to write shop orders
SANITY_WRITE_TOKEN=
# Editor token used by contact.mts and newsletter.mts
SANITY_API_TOKEN=
# Signing secret of the Stripe webhook endpoint for /api/webhook (shop orders)
STRIPE_WEBHOOK_SECRET=
# Where new-order / new-commission / contact notifications go
TEAM_EMAIL=
# Sender for all transactional email, e.g. Pixel8 Multimedia <orders@pixel8multimedia.co.uk>
EMAIL_FROM=
# Reply-to address on proof emails
EMAIL_REPLY_TO=
# Logo image URL used in contact emails
EMAIL_LOGO_URL=
# Fallback public site URL when URL isn't set
SITE_URL=
# Salt for IP hashing and the internal function-to-function key — set a long random value
PERSONALISATION_SALT=
# Version string recorded with each Your Photo consent
PERSONALISATION_CONSENT_VERSION=
# Print file size in px for Your Photo prints (default 4096)
PERSONALISATION_PRINT_PX=
# Google AI key for Your Photo styling
GOOGLE_AI_API_KEY=
# Image model override for Your Photo styling
STYLE_MODEL=
# Optional external upscaler for print files (URL and bearer token)
UPSCALE_SERVICE_URL=
UPSCALE_SERVICE_TOKEN=
# Cloudflare Turnstile on the Your Photo upload (public site key, server secret)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# MailerLite newsletter sync
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
# Basic auth for /admin/* (netlify/edge-functions/admin-auth.ts)
ADMIN_USER=
ADMIN_PASSWORD=
# SITE_NAME is set by Netlify at runtime; functions use https://<SITE_NAME>.netlify.app to call each other
